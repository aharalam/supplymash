PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# IBM watsonx.ai (optional — fill in when using AI matching features)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Cloudant (optional — for persistent storage)
CLOUDANT_URL=
CLOUDANT_API_KEY=

# Granite chat model ID (copy one from Prompt Lab, Dallas region). Defaults to ibm/granite-4-h-small (the Granite chat model offered in Dallas).
# Without WATSONX_API_KEY + WATSONX_PROJECT_ID the app uses its built-in parser and text templates.
WATSONX_MODEL_ID=

# Stripe TEST mode only: the server refuses to start with any other key.
# Without it, charges are mocked (status mock_succeeded).
STRIPE_SECRET_KEY=
