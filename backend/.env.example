PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# IBM watsonx.ai (optional — fill in when using AI matching features)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Cloudant (optional — for persistent storage)
CLOUDANT_URL=
CLOUDANT_API_KEY=

# Granite chat model ID (pick a current Granite model in Prompt Lab, Dallas region)
WATSONX_MODEL_ID=

# Stripe TEST mode only — key must start with sk_test_
STRIPE_SECRET_KEY=
